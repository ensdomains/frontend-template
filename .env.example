# All optional. Copy to .env.local to use.
# These are bundled into the client, so only use values that are safe to expose.

# Get one at https://dashboard.reown.com to enable WalletConnect (mobile wallets)
VITE_WALLETCONNECT_PROJECT_ID=

# Your own RPCs. Defaults to PublicNode.
VITE_MAINNET_RPC_URL=
VITE_SEPOLIA_RPC_URL=
